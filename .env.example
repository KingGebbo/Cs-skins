# Vercel Postgres – added automatically when you connect Vercel Postgres in your project dashboard
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Optional: Slack or Discord webhook URL for pump alerts
WEBHOOK_URL=

# Vercel Cron Secret – set a random string, add it in Vercel → Settings → Environment Variables
CRON_SECRET=
